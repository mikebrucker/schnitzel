      { "de": "der Kaffee", "en": "coffee" },
      { "de": "das Brot", "en": "bread" },
      { "de": "der Käse", "en": "cheese" },
      { "de": "die Rechnung, bitte", "en": "The bill, please" },
      { "de": "Zahlen, bitte", "en": "Pay, please", "note": "Austrian way to ask for bill" },
      { "de": "Prost!", "en": "Cheers!" },
      {
        "de": "Mahlzeit!",
        "en": "Enjoy your meal / hello at lunch",
        "note": "Heard everywhere in Austria"
      }
    ],
    "grammar": "German nouns have three genders: der (masc), die (fem), das (neut). You MUST learn the article with the noun. There is no shortcut.",
    "example": {
      "de": "Ich möchte ein Bier und die Rechnung, bitte.",
      "en": "I would like a beer and the bill, please."
    }
  },
