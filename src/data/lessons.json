      { "de": "Guten Abend", "en": "Good evening" },
      { "de": "Auf Wiedersehen", "en": "Goodbye (formal)" },
      { "de": "Tschüss", "en": "Bye (casual)" },
      { "de": "Wie heißt du?", "en": "What is your name? (informal)" },
      { "de": "Ich heiße…", "en": "My name is…" },
      { "de": "Servus", "en": "Hi/bye", "note": "Austrian — use this in Tirol!" },
      { "de": "Grüß Gott", "en": "Hello", "note": "Formal Austrian greeting" }
    ],
    "grammar": "German has formal (Sie) and informal (du) 'you'. In Tirol, locals are very friendly and often jump to 'du' fast — but use 'Sie' first with strangers, older people, and in shops.",
    "example": { "de": "Grüß Gott! Ich heiße Bruck.", "en": "Hello! My name is Bruck." }
  },
